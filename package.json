{
  "name": "@jrmi/use-socket.io",
  "version": "1.6.0",
  "description": "React hook for socket.io",
  "private": false,
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./lib/index.d.mts",
        "require": "./lib/index.d.cts"
      },
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "lint": "eslint 'src/**'",
    "lint:fix": "eslint 'src/**' --fix && prettier --write 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "hooks",
    "socket",
    "socket.io"
  ],
  "author": "Jérémie Pardou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrmi/use-socket.io.git"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">= 16.10",
    "react-dom": ">= 16.10",
    "socket.io-client": ">= 4.0.0 < 5"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  }
}
